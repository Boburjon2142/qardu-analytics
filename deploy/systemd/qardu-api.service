[Unit]
Description=QarDU Analytics API (gunicorn)
After=network.target postgresql.service

[Service]
User=qardu
Group=qardu
WorkingDirectory=/var/www/qardu/api
EnvironmentFile=/var/www/qardu/api.env
ExecStart=/var/www/qardu/api/.venv/bin/python -m gunicorn config.wsgi:application --bind 127.0.0.1:8100 --workers 2
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
