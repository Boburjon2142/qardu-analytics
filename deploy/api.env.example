# Production environment for the API. On the server: /etc/qardu/api.env (root:qardu, chmod 640).
# Never commit real values. Generate secrets with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# (URL-safe output: no quotes or $ needed, safe for both systemd and bash.)
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=<generate>
DJANGO_ALLOWED_HOSTS=stat.qarshidu.uz
DJANGO_CSRF_TRUSTED_ORIGINS=https://stat.qarshidu.uz
# Nginx is the single trusted proxy and overwrites X-Forwarded-For with the client address.
DRF_NUM_PROXIES=1

POSTGRES_DB=qardu_analytics
POSTGRES_USER=qardu
POSTGRES_PASSWORD=<generate>
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Python must not write bytecode into the read-only release directory at runtime.
PYTHONDONTWRITEBYTECODE=1
