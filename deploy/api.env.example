# Copy to /var/www/qardu/api.env on the server (chmod 600). Never commit real values.
DJANGO_SETTINGS_MODULE=config.settings.base
DJANGO_SECRET_KEY=<generate: python -c "import secrets;print(secrets.token_urlsafe(50))">
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=213.230.96.104
DJANGO_CSRF_TRUSTED_ORIGINS=http://213.230.96.104
# Plain HTTP over a bare IP: Secure cookies would never be sent. Set true once TLS exists.
DJANGO_COOKIE_SECURE=false
DRF_NUM_PROXIES=1
POSTGRES_DB=qardu_analytics
POSTGRES_USER=qardu
POSTGRES_PASSWORD=<set a strong password>
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
